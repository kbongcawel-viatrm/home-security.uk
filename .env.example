# Copy to .env and replace lab defaults before exposing services.

SECSTACK_UID=1000
SECSTACK_GID=1000
SENSOR_INTERFACE=eth0
# Keep SECDNS_IPV4 and FQDN_PROXY_IPV4 inside SECNET_CIDR.
SECNET_CIDR=10.77.0.0/24
SECNET_GATEWAY=10.77.0.1
# Default compose profiles used by scripts/start-stack.sh.
SECSTACK_PROFILES=all

COREDNS_VERSION=1.11.3
CADDY_VERSION=2.8.4-alpine
# Populate from GitHub Actions secrets in CI, or set locally before starting the DNS profile.
CADDY_CROWDSEC_API_KEY=
SECDNS_HOST_IP=127.0.0.1
SECDNS_PORT=1053
SECDNS_IPV4=10.77.0.53
FQDN_PROXY_IPV4=10.77.0.80
FQDN_HTTP_HOST_IP=127.0.0.1
FQDN_HTTP_PORT=8081
FQDN_HTTPS_HOST_IP=127.0.0.1
FQDN_HTTPS_PORT=8443
STACK_BIND_IP=127.0.0.1
# Set to true to free unused Docker layers before prewarming and startup.
DOCKER_CACHE_PRUNE_BEFORE_PULL=false
# Harbor proxy cache host and per-registry proxy projects.
# Example: HARBOR_CACHE_HOST=demo.goharbor.io
HARBOR_CACHE_HOST=
HARBOR_CACHE_USERNAME=
HARBOR_CACHE_PASSWORD=
HARBOR_CACHE_PROJECT_DOCKERIO=hq-sec-stack-dockerio
HARBOR_CACHE_PROJECT_DOCKERHUB=hq-sec-stack-dockerhub
HARBOR_CACHE_PROJECT_GHCR=hq-sec-stack-gh
HARBOR_CACHE_PROJECT_GREENBONE=hq-sec-stack-greenbone
HARBOR_CACHE_PROJECT_DEFAULT=hq-sec-stack-gh

VAULT_VERSION=1.18
VAULT_HTTP_PORT=8200
VAULT_ADDR=http://vault:8200
VAULT_KV_MOUNT=secret
# Do not commit real Vault tokens. Set this in .env after Vault init/unseal.
VAULT_ROTATOR_TOKEN=
VAULT_ROTATION_DAY=1
VAULT_ROTATION_CHECK_SECONDS=21600
VAULT_ROTATION_RUN_ON_STARTUP=false

BACKUP_ALPINE_VERSION=3.20
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=30
BACKUP_RUN_ON_STARTUP=true
BACKUP_ONCE=false

# Trivy v0.70.0 is pinned because v0.69.4-v0.69.6 were affected by a 2026 supply-chain advisory.
TRIVY_VERSION=0.70.0
TRIVY_SCAN_INTERVAL_SECONDS=86400
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=0
TRIVY_RUN_ON_STARTUP=true
TRIVY_SCAN_ONCE=false

FLUENT_BIT_VERSION=3.2.10
PYTHON_ALPINE_VERSION=3.12-alpine
CURL_VERSION=8.10.1
GRAYLOG_GELF_ADDRESS=127.0.0.1
# ── The Ghost (LLM governance — governs all body parts) ──
# [NOTE] GHOST_MODEL is a universal selector.
# It handles the local Ghost runtime by default, but can use cloud models like ChatGPT
# if an OPENAI_API_KEY is provided and the model name starts with 'gpt-'.
GHOST_VERSION=0.20.7
GHOST_PORT=11434
GHOST_MODEL=gpt-4-turbo
# Space-separated list of local models to pre-pull on startup (only used for the local Ghost runtime fallback).
GHOST_MODELS_TO_PULL="llama3.2 llama3.1 gemma2"
# OpenAI API Key for using ChatGPT (GPT-4 Turbo). 
# If set and GHOST_MODEL starts with 'gpt', The Ghost will use OpenAI.
OPENAI_API_KEY=
GHOST_LOCAL_API=http://ghost:11434
GHOST_CRON=0 2 * * *
GHOST_RUN_ON_STARTUP=true
GHOST_MAX_LOG_LINES=2500
GHOST_CONTEXT_CHARS=24000
# CrowdSec LAPI key for The Ghost (Shield/Sword governance).
# Generate with: docker exec crowdsec cscli bouncers add the-ghost
CROWDSEC_LAPI_URL=http://crowdsec:8080
CROWDSEC_API_KEY=
UPTIME_KUMA_VERSION=1.23.16
UPTIME_KUMA_PORT=3002
UPTIME_KUMA_URL=http://uptime-kuma:3001
UPTIME_KUMA_USERNAME=admin
# Set after first Uptime Kuma setup. Do not commit the real value.
UPTIME_KUMA_PASSWORD=
UPTIME_KUMA_SYNC_INTERVAL_SECONDS=21600
UPTIME_KUMA_SYNC_RUN_ON_STARTUP=true
PORTAINER_HTTP_PORT=9002
PORTAINER_HTTPS_PORT=9443

WAZUH_VERSION=4.14.4
WAZUH_INDEXER_PORT=9200
WAZUH_EVENTS_PORT=1514
WAZUH_FALLBACK_SYSLOG_PORT=1516
WAZUH_ENROLLMENT_PORT=1515
WAZUH_API_PORT=55000
WAZUH_DASHBOARD_PORT=5601
WAZUH_DASHBOARD_USERNAME=admin
WAZUH_DASHBOARD_PASSWORD=SecretPassword
WAZUH_INDEXER_JAVA_OPTS=-Xms1g -Xmx1g
WAZUH_FILEBEAT_SSL_VERIFICATION_MODE=none

GRAYLOG_VERSION=7.0.6
MONGO_VERSION=7.0.29
GRAYLOG_HTTP_PORT=9000
GRAYLOG_HTTP_EXTERNAL_URI=http://localhost:9000/
GRAYLOG_API_URL=http://graylog:9000/api
GRAYLOG_ROOT_USERNAME=admin
GRAYLOG_ROOT_PASSWORD=admin
GRAYLOG_GELF_UDP_PORT=12201
GRAYLOG_SYSLOG_TCP_PORT=5514
GRAYLOG_SYSLOG_UDP_PORT=5514
GRAYLOG_PASSWORD_SECRET=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME
# Default Graylog admin password is "admin"; replace before real use.
GRAYLOG_ROOT_PASSWORD_SHA2=8c6976e5b5410415bde908bd4dee15dfb167a9c873fc4bb8a81f6f2ab448a918
GRAYLOG_DATANODE_JAVA_OPTS=-Xms1g -Xmx1g

SURICATA_VERSION=7.0
SURICATA_RUN_USER=suricata
SURICATA_RUN_GROUP=suricata
SURICATA_UPDATE_INTERVAL_SECONDS=86400
SURICATA_UPDATE_RUN_ON_STARTUP=true
SURICATA_UPDATE_ONCE=false
SURICATA_UPDATE_ENABLE_SOURCES=et/open oisf/trafficid ptresearch/attackdetection sslbl/ssl-fp-blacklist sslbl/ja3-fingerprints abuse.ch/sslbl-c2 abuse.ch/urlhaus
ZEEK_VERSION=lts

THEHIVE_VERSION=5.7
THEHIVE_HTTP_PORT=9001
THEHIVE_JVM_OPTS=-Xms512m -Xmx1g
THEHIVE_PLAY_SECRET=CHANGE_ME_THEHIVE_LAB_SECRET_KEY_CHANGE_ME

SHUFFLE_VERSION=latest
SHUFFLE_WORKER_VERSION=nightly
SHUFFLE_BACKEND_HOSTNAME=shuffle-backend
SHUFFLE_OUTER_HOSTNAME=shuffle-backend
SHUFFLE_ENVIRONMENT_NAME=Shuffle
SHUFFLE_ORG_ID=Shuffle
SHUFFLE_DOCKER_API_VERSION=1.40
SHUFFLE_OPENSEARCH_PASSWORD=CHANGE_ME_SHUFFLE_OPENSEARCH_SECRET
SHUFFLE_BASE_URL=http://localhost:3001
SHUFFLE_FRONTEND_PORT=3001
SHUFFLE_BACKEND_PORT=5001
SHUFFLE_APP_SECRET=CHANGE_ME_SHUFFLE_LAB_SECRET

VELOCIRAPTOR_VERSION=0.76.1
VELOCIRAPTOR_GUI_PORT=8889
VELOCIRAPTOR_FRONTEND_PORT=8000
VELOCIRAPTOR_ADMIN_PASSWORD=admin

ANSIBLE_VERSION=2.16-tools
OSQUERY_VERSION=5.8.2-ubuntu22.04

GREENBONE_IMAGE_TAG=stable
GREENBONE_REDIS_TAG=latest
GREENBONE_DATA_TAG=latest
SCAP_DATA_IMAGE=docker.io/vulnvision/greenbone-scap-data:latest
GREENBONE_GSA_TAG=stable-slim
GREENBONE_CONFIG_TAG=latest
GREENBONE_FEED_RELEASE=24.10
GREENBONE_HTTPS_PORT=9444
GREENBONE_GSA_PORT=9392
GREENBONE_ADMIN_USER=admin
GREENBONE_ADMIN_PASSWORD=admin

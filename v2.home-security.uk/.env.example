# Copy to .env and replace the example password before starting.
TZ=Asia/Manila

# Keep Wazuh manager aligned with the Wazuh agents you deploy.
WAZUH_VERSION=4.14.8
WAZUH_AGENT_PORT=1514
WAZUH_ENROLLMENT_PORT=1515
WAZUH_API_PORT=55000

# Native host Suricata log directory; ensure containers can read it under SELinux.
SURICATA_LOG_DIR=/var/log/suricata

# Dashboard is bound to localhost by default.
OPENOBSERVE_TAG=latest
OPENOBSERVE_PORT=5080
OPENOBSERVE_USER=admin@home-security.local
OPENOBSERVE_PASSWORD=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD
OPENOBSERVE_ORG=default

OLLAMA_TAG=latest
OLLAMA_MODEL=qwen2.5:3b

FLUENT_BIT_TAG=3.2

# AI analysis cadence and batch cap
ANALYSIS_INTERVAL_SECONDS=300
MAX_EVENTS_PER_BATCH=30

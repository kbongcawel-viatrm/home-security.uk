{
    admin off

    log default {
        output file /var/log/caddy/access.log
        format json
    }
}

# MVP analyst-facing routes for simplified.compose.yml. Caddy's local
# internal CA is used for HTTPS.
http://caddy.home-security.local {
    respond /healthz 200
}

https://caddy.home-security.local {
    tls internal
    respond /healthz 200
}

https://uptimekuma.home-security.local {
    tls internal
    reverse_proxy http://uptime-kuma:3001
}

https://graylog.home-security.local {
    tls internal
    reverse_proxy http://graylog:9000
}

https://wazuh.home-security.local {
    tls internal
    reverse_proxy https://wazuh-dashboard:5601 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

https://wazuh-api.home-security.local {
    tls internal
    reverse_proxy https://wazuh-manager:55000 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

https://wazuh-indexer.home-security.local {
    tls internal
    reverse_proxy https://wazuh-indexer:9200 {
        transport http {
            tls_insecure_skip_verify
        }
    }
}

https://graylog-datanode.home-security.local {
    tls internal
    reverse_proxy http://graylog-datanode:9200
}

https://reports.home-security.local {
    tls internal
    root * /usr/share/caddy
    file_server
}
